# Exact public origin when hosted behind HTTPS. No trailing path.
# APP_ORIGIN=https://weldpoint.example
# Production defaults: demo login disabled. Enable only for a private playtest.
# DEMO_AUTH=true
# Persistent SQLite path (default: .data/accounts.sqlite)
# AUTH_DB_PATH=/persistent-data/accounts.sqlite
# Optional contract-wallet verification. Never prefix server secrets with VITE_.
# ETHEREUM_RPC_URL=https://your-mainnet-rpc
# SEPOLIA_RPC_URL=https://your-sepolia-rpc
# Production listening port (default: 5173)
# PORT=5173
# Arkiv Rabdi setup: npm run arkiv:setup creates .env.local without printing secrets.
# Obtain a free key at https://hub.arkiv.network/access-keys
# Fund the generated public signer at https://hub.arkiv.network/faucet
# ARKIV_ACCESS_KEY=
# ARKIV_PRIVATE_KEY=0x... (dedicated testnet signer, generated by setup)
# ARKIV_ENCRYPTION_KEY=... (independent 64-hex-character secret, generated by setup)
# Back up the encryption key privately: losing it loses access to encrypted levels.
# Budgets are in Rabdi test GLM; zero disables writes. Configure after reviewing estimates.
# ARKIV_MAX_TX_FEE_GLM=0
# ARKIV_DAILY_FEE_BUDGET_GLM=0
# Public query namespace; changing it requires a separate journal.
# ARKIV_NAMESPACE=weldpoint
# Persist the transaction journal alongside the account database.
# ARKIV_JOURNAL_PATH=/persistent-data/arkiv.sqlite
# Comma-separated Ethereum addresses allowed to publish verified campaign levels.
# Development Atlas is an admin only while demo authentication is enabled.
# CAMPAIGN_PUBLISHER_WALLETS=0xYourWalletAddress
