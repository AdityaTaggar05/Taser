# Exact public origin when hosted behind HTTPS. No trailing path.
# APP_ORIGIN=https://weldpoint.example
# Production defaults: demo login disabled. Enable only for a private playtest.
# DEMO_AUTH=true
# Persistent SQLite path (default: .data/accounts.sqlite)
# AUTH_DB_PATH=/persistent-data/accounts.sqlite
# Optional contract-wallet verification. Never prefix server secrets with VITE_.
# ETHEREUM_RPC_URL=https://your-mainnet-rpc
# SEPOLIA_RPC_URL=https://your-sepolia-rpc
# Production listening port (default: 5173)
# PORT=5173
# Arkiv Rabdi setup: npm run arkiv:setup creates .env.local without printing secrets.
# Obtain a free key at https://hub.arkiv.network/access-keys
# Fund the generated public signer at https://hub.arkiv.network/faucet
# ARKIV_ACCESS_KEY=
# ARKIV_PRIVATE_KEY=0x... (dedicated testnet signer, generated by setup)
# ARKIV_ENCRYPTION_KEY=... (independent 64-hex-character secret, generated by setup)
# Back up the encryption key privately: losing it loses access to encrypted levels.
# Budgets are in Rabdi test GLM; zero disables writes. Configure after reviewing estimates.
# ARKIV_MAX_TX_FEE_GLM=0
# ARKIV_DAILY_FEE_BUDGET_GLM=0
# Public query namespace; changing it requires a separate journal.
# ARKIV_NAMESPACE=weldpoint
# Persist the transaction journal alongside the account database.
# ARKIV_JOURNAL_PATH=/persistent-data/arkiv.sqlite
# Comma-separated Ethereum addresses allowed to publish verified campaign levels.
# Development Atlas is an admin only while demo authentication is enabled.
# CAMPAIGN_PUBLISHER_WALLETS=0xYourWalletAddress

# Swarm upload credentials stay server-side. Use an upload-capable Bee node or
# a sponsor-provided Bee-compatible service with an existing usable postage batch.
# SWARM_BEE_URL=http://127.0.0.1:1633
# SWARM_POSTAGE_BATCH_ID=64_hex_characters
# Optional Bearer token for a protected upload service:
# SWARM_AUTH_TOKEN=
# Public, credential-free read endpoint (must serve /bzz and allow browser CORS):
# SWARM_GATEWAY_URL=https://api.gateway.ethswarm.org
# Optional local Bee pin; this does not replace postage renewal:
# SWARM_PIN_UPLOAD=false

# CRE certification: unconfigured keeps new submissions pending and locked.
# Existing legacy levels stay playable. Simulation is never labeled as live DON execution.
# CRE_MODE=unconfigured
# Automatic publish after a successful local CRE CLI run (no Sepolia certificate):
# Run npm run cre:local-mode to select CRE_MODE=cli-simulation in .env.local.
# The server must be able to reach itself at this origin:
# CRE_API_BASE=http://127.0.0.1:5173
# CRE_BIN=cre
# Preserve this private receipt database alongside the account/archive databases:
# CRE_CLI_RECEIPTS_PATH=.data/cre/cli-receipts.sqlite
# CRE_MODE=simulation requires the Sepolia registry below; CRE_MODE=don uses live reports.
# CRE_REGISTRY_ADDRESS=0xYourSepoliaRegistry
# CRE_SEPOLIA_RPC_URL=https://your-sepolia-rpc
# Separate verifier-only HTTP credential; npm run cre:setup generates it privately.
# CRE_API_TOKEN=
# Operator commands only (not required by the game server):
# CRE_ETH_PRIVATE_KEY=0x... (dedicated Sepolia signer; generated by cre:setup)
# Use the MockForwarder reported by your CLI tenant for simulation.
# CRE_FORWARDER_ADDRESS=0xYourForwarder
# Live DON deployments additionally require their exact workflow ID:
# CRE_WORKFLOW_ID=0x...
# Explicit caps for the operator deploy/register commands. Zero disables writes.
# CRE_MAX_TX_FEE_ETH=0
# CRE_DAILY_FEE_BUDGET_ETH=0
