# Exact public origin when hosted behind HTTPS. No trailing path.
# APP_ORIGIN=https://weldpoint.example
# Production defaults: demo login disabled. Enable only for a private playtest.
# DEMO_AUTH=true
# Persistent SQLite path (default: .data/accounts.sqlite)
# AUTH_DB_PATH=/persistent-data/accounts.sqlite
# Optional contract-wallet verification. Never prefix server secrets with VITE_.
# ETHEREUM_RPC_URL=https://your-mainnet-rpc
# SEPOLIA_RPC_URL=https://your-sepolia-rpc
# Production listening port (default: 5173)
# PORT=5173
