{
  "name": "weldpoint",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "start": "tsx server/index.ts",
    "arkiv:setup": "node scripts/arkiv-setup.mjs",
    "arkiv:check": "node scripts/arkiv-check.mjs",
    "arkiv:quote": "tsx scripts/arkiv-migrate.ts --quote",
    "arkiv:migrate": "tsx scripts/arkiv-migrate.ts --write",
    "assets:prepare": "node scripts/prepare-theme.mjs",
    "assets:check": "node --import tsx scripts/swarm-assets.ts",
    "assets:upload": "node --import tsx scripts/swarm-assets.ts --write",
    "assets:verify": "node --import tsx scripts/swarm-assets.ts --verify",
    "assets:public:check": "node --import tsx scripts/swarm-public-assets.ts",
    "assets:upload:public": "node --import tsx scripts/swarm-public-assets.ts --write",
    "assets:verify:public": "node --import tsx scripts/swarm-public-assets.ts --verify",
    "arkiv:theme:quote": "node --import tsx scripts/arkiv-theme.ts --quote",
    "arkiv:theme:publish": "node --import tsx scripts/arkiv-theme.ts --write"
  },
  "dependencies": {
    "@arkiv-network/sdk": "1.0.1",
    "arkiv-encryption": "1.1.1",
    "phaser": "^3.90.0",
    "tsx": "^4.23.15",
    "viem": "^2.57.16",
    "ws": "^8.22.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/ws": "^8.18.2",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.1.0"
  }
}
